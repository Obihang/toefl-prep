rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    
    match /{document=**} {
      allow read, write: if false;
    }

    match /questions/{questionId} {
      allow read, create: if isOwner(resource != null ? resource.data.userId : request.resource.data.userId);
    }

    match /completions/{completionId} {
      allow read, create: if isOwner(request.resource.data.userId);
    }

    match /userStats/{userId} {
      allow read, update: if isOwner(userId);
      
      match /completedDays/{dayId} {
        allow read, create: if isOwner(userId);
      }
    }

    match /vocabulary/{wordId} {
      allow read, create, delete: if isOwner(request.resource != null ? request.resource.data.userId : resource.data.userId);
    }
  }
}
