rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidTaskType(t) {
      return t in [
        'complete-words',
        'reading-passage',
        'listening-dialogue',
        'listen-repeat',
        'speaking-interview',
        'build-sentence',
        'write-email',
        'academic-discussion',
        'reading',
        'listening'
      ];
    }

    match /{document=**} {
      allow read, write: if false;
    }

    // Shared Question Bank
    match /questions/{questionId} {
      // Authenticated users (including anonymous auth) can read questions
      allow read: if isSignedIn();

      // On create, require valid taskType, contentHash, createdBy, and useCount
      allow create: if isSignedIn()
        && isValidTaskType(request.resource.data.taskType)
        && request.resource.data.contentHash is string
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.useCount is number
        && request.resource.data.content is map;

      // Only allow incrementing useCount or attaching audioUrl
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['useCount', 'audioUrl'])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['useCount'])
          || request.resource.data.useCount == resource.data.useCount + 1
        );

      allow delete: if false;
    }

    // Per-User Progress (seen question IDs)
    match /userProgress/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    match /completions/{completionId} {
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    match /mistakes/{mistakeId} {
      allow read, delete, create, update: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /vocabulary/{wordId} {
      allow read, delete, create, update: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /userStats/{uid} {
      allow read, create, update, delete: if isSignedIn() && uid == request.auth.uid;

      match /completedDays/{dayId} {
        allow read, create, update: if isSignedIn() && uid == request.auth.uid;
        allow delete: if false;
      }
    }
  }
}
