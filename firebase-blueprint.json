{
  "entities": {
    "Question": {
      "title": "TOEFL Question",
      "description": "A shared TOEFL question in the question bank.",
      "type": "object",
      "properties": {
        "taskType": { "type": "string" },
        "level": { "type": "string" },
        "topic": { "type": "string" },
        "content": { "type": "object" },
        "contentHash": { "type": "string" },
        "audioUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" },
        "useCount": { "type": "number" },
        "reportCount": { "type": "number" }
      },
      "required": ["taskType", "level", "topic", "content", "contentHash", "createdBy", "useCount"]
    },
    "Report": {
      "title": "Global User Report",
      "description": "User submitted issue or feedback report.",
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "username": { "type": "string" },
        "context": { "type": "string" },
        "uid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "resolved": { "type": "boolean" }
      },
      "required": ["text", "username", "context", "uid", "createdAt", "resolved"]
    },
    "QuestionReport": {
      "title": "Question Report",
      "description": "Per-question user flag / report.",
      "type": "object",
      "properties": {
        "questionId": { "type": "string" },
        "uid": { "type": "string" },
        "reason": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["questionId", "uid", "reason", "createdAt"]
    },
    "UserProgress": {
      "title": "User Progress",
      "description": "Tracks seen question IDs to prevent repeats.",
      "type": "object",
      "properties": {
        "seenQuestionIds": {
          "type": "array",
          "items": { "type": "string" }
        },
        "lastUpdated": { "type": "string", "format": "date-time" }
      },
      "required": ["seenQuestionIds"]
    },
    "TaskCompletion": {
      "title": "Task Completion",
      "description": "A record of a completed practice task.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "taskType": { "type": "string" },
        "completedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "taskType", "completedAt"]
    },
    "UserStats": {
      "title": "User Statistics",
      "description": "User practice statistics.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "currentStreak": { "type": "number" },
        "lastCompletedDate": { "type": "string", "format": "date" }
      },
      "required": ["userId", "currentStreak"]
    },
    "CompletedDay": {
      "title": "Completed Day",
      "description": "A day when the user completed at least one task.",
      "type": "object",
      "properties": {
        "date": { "type": "string", "format": "date" }
      },
      "required": ["date"]
    },
    "VocabularyWord": {
      "title": "Vocabulary Word",
      "description": "A saved vocabulary word.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "word": { "type": "string" },
        "definition": { "type": "string" },
        "context": { "type": "string" },
        "leitnerBox": { "type": "number" },
        "nextReviewDate": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "word", "definition", "leitnerBox", "nextReviewDate", "createdAt"]
    },
    "Mistake": {
      "title": "Mistake",
      "description": "A recorded mistake from a practice session.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "questionId": { "type": "string" },
        "taskType": { "type": "string" },
        "correctAnswer": { "type": "string" },
        "userAnswer": { "type": "string" },
        "explanation": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "questionId", "taskType", "correctAnswer", "userAnswer", "createdAt"]
    }
  },
  "firestore": {
    "/questions/{questionId}": {
      "schema": "Question",
      "description": "Storage for shared question bank."
    },
    "/reports/{reportId}": {
      "schema": "Report",
      "description": "Global issue and feedback reports."
    },
    "/questionReports/{reportDocId}": {
      "schema": "QuestionReport",
      "description": "Per-question user reports."
    },
    "/userProgress/{userId}": {
      "schema": "UserProgress",
      "description": "Tracks seen question IDs per user."
    },
    "/completions/{completionId}": {
      "schema": "TaskCompletion",
      "description": "Record of all task completions."
    },
    "/userStats/{userId}": {
      "schema": "UserStats",
      "description": "Stores current streak for a user."
    },
    "/userStats/{userId}/completedDays/{dayId}": {
      "schema": "CompletedDay",
      "description": "Subcollection of days user was active."
    },
    "/vocabulary/{wordId}": {
      "schema": "VocabularyWord",
      "description": "Saved vocabulary words for a user."
    },
    "/mistakes/{mistakeId}": {
      "schema": "Mistake",
      "description": "Saved mistakes for a user."
    }
  }
}
