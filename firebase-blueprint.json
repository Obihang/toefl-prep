{
  "entities": {
    "Question": {
      "title": "TOEFL Question",
      "description": "A generated TOEFL question.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "taskType": { "type": "string" },
        "level": { "type": "string" },
        "topic": { "type": "string" },
        "data": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "taskType", "level", "topic", "data", "createdAt"]
    }
  },
  "firestore": {
    "/questions/{questionId}": {
      "schema": "Question",
      "description": "Storage for generated questions."
    }
  }
}
